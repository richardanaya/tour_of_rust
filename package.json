{
  "scripts": {
    "lint:lessons": "prettier --write ./lessons/*/*.yaml",
    "lint": "npm run lint:lessons && eslint --fix generate.js docs/",
    "prebuild": "npm run clean",
    "build": "node generate.js lessons docs beta",
    "serve": "npm run build && cd docs && python  -m http.server 8080",
    "clean": "rimraf ./docs/*.html",
    "watch": "nodemon -w lessons/**/* -e yaml --exec npm run serve"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4"
  }
}
